-- ====== 🧹 1. 自动清理历史 UI，防止手机端多层叠加卡顿 =======
for _, oldUI in ipairs(game:GetService("CoreGui"):GetChildren()) do
    if oldUI.Name == "MinFarmUI" or oldUI.Name == "修仙终极完全体面板" then
        oldUI:Destroy()
    end
end

-- ======= 🛠️ 2. 手动核心控制参数中心 =======
_G.AutoLocalFarm = false     -- 默认关闭
_G.FarmRadius = 100          -- [要求1：范围控制] 以开启时的原点为中心，半径100码内打怪
_G.WalkSpeedLimit = 45       -- [要求2：稳定性] 平滑移动速度，纯靠物理速度推移，坚决不瞬移/飞天
_G.AttackDelay = 0.25        -- [要求3：速度调节] 每次攻击的间隔时间（秒），可在UI中随时手调

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local homeAnchor = nil -- 挂机圆心锚点

-- NPC过滤黑名单
local NPC_BLACKLIST = {"npc", "shop", "商人", "道人", "师傅", "导师", "任务", "quest", "villager", "村民", "铁匠", "传送", "dummy"}
local function isNpc(model)
    local name = string.lower(model.Name)
    for _, keyword in ipairs(NPC_BLACKLIST) do
        if string.find(name, keyword) then return true end
    end
    return Players:GetPlayerFromCharacter(model) ~= nil
end

-- ====== 📱 3. 极简手机端专属 UI（大小适中、支持拖动） ======
