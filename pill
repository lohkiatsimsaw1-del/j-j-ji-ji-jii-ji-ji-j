    ["Awakening Qi Pill"]   = {"Ginseng", "Ginseng", "Spirit Grass", "Spirit Grass"},
    ["Perfect Qi Pill"]     = {"Ginseng", "Spirit Grass", "Spirit Grass", "Lotus"},
    ["Moonlight Qi Pill"]   = {"Moonlight Flower", "Moonlight Flower", "Moonlight Flower", "Moonlight Flower"},
    ["Nine Rotations Pill"] = {"Blood Flower", "Blood Flower", "Lotus", "Blood Flower"},
    ["Dark Pill"]           = {"Ginseng", "Ginseng", "Ginseng", "Ginseng"}, -- 备用兜底
    ["Heavenly Pill"]       = {"Lotus", "Lotus", "Moonlight Flower", "Moonlight Flower"},
    ["Demonic Pill"]        = {"Blood Flower", "Blood Flower", "Blood Flower", "Blood Flower"},
    ["Dragon Pill"]         = {"Ginseng", "Spirit Grass", "Lotus", "Blood Flower"},
    ["Divine Ascension Pill"] = {"Ginseng", "Ginseng", "Moonlight Flower", "Lotus"},
    ["Endless Flow Pill"]   = {"Blood Flower", "Spirit Grass", "Lotus", "Moonlight Flower"}
}

-- 支持切换的年份列表
local YEAR_LIST = {"1 years", "10years", "100years", "1000years", "10000years", "100000years"}
local PILL_LIST = {"Awakening Qi Pill", "Perfect Qi Pill", "Moonlight Qi Pill", "Nine Rotations Pill", "Heavenly Pill", "Demonic Pill", "Dragon Pill", "Divine Ascension Pill", "Endless Flow Pill"}

local currentPillIndex = 1
local currentYearIndex = 1

-- =================================================================
-- 📱 3. 手机端适配：双色极简交互面板
-- =================================================================
local ScreenGui = Instance.new("ScreenGui", CoreGui)
