PillBtn.Activated:Connect(function()
    currentPillIndex = currentPillIndex % #PILL_LIST + 1
    _G.SelectedPill = PILL_LIST[currentPillIndex]
    PillBtn.Text = "目标丹药: " .. _G.SelectedPill
