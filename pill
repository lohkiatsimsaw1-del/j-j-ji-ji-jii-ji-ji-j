-- ====== 🏹 创建一个绝对图层（确保箭头能无条件显示） ======
local ArrowGui = Instance.new("ScreenGui", CoreGui)
ArrowGui.Name = "AlchemyArrowGui"
ArrowGui.DisplayOrder = 9999 -- 强行置顶在所有UI最前面

local VisualArrow = Instance.new("TextLabel", ArrowGui)
VisualArrow.Size = UDim2.new(0, 50, 0, 50)
VisualArrow.BackgroundTransparency = 1
VisualArrow.Text = "⚡⬇️" 
VisualArrow.TextSize = 40
VisualArrow.TextColor3 = Color3.fromRGB(255, 0, 0)
VisualArrow.Visible = false

-- 底层物理绝对坐标点击
local function hardClick(element)
    if not element then return end
    local x = element.AbsolutePosition.X + (element.AbsoluteSize.X / 2)
    local y = element.AbsolutePosition.Y + (element.AbsoluteSize.Y / 2)
    
    -- 强行展示红色箭头
    VisualArrow.Position = UDim2.new(0, x - 25, 0, y - 55)
    VisualArrow.Visible = true
    
    -- 敲击模拟
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    print("▶️ [系统已执行物理敲击] 坐标位置: " .. x .. ", " .. y)
end

