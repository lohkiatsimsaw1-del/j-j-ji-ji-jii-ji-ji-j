local PILL_RECIPES = {
    ["Awakening Qi Pill"]   = {"Ginseng", "Ginseng", "Spirit Grass", "Spirit Grass"},
    ["Perfect Qi Pill"]     = {"Ginseng", "Spirit Grass", "Spirit Grass", "Lotus"},
    ["Moonlight Qi Pill"]   = {"Moonlight Flower", "Moonlight Flower", "Moonlight Flower", "Moonlight Flower"},
    ["Nine Rotations Pill"] = {"Blood Flower", "Blood Flower", "Lotus", "Blood Flower"},
    ["Heavenly Pill"]       = {"Lotus", "Lotus", "Moonlight Flower", "Moonlight Flower"},
    ["Demonic Pill"]        = {"Blood Flower", "Blood Flower", "Blood Flower", "Blood Flower"},
    ["Dragon Pill"]         = {"Ginseng", "Spirit Grass", "Lotus", "Blood Flower"},
    ["Divine Ascension Pill"] = {"Ginseng", "Ginseng", "Moonlight Flower", "Lotus"},
    ["Endless Flow Pill"]   = {"Blood Flower", "Spirit Grass", "Lotus", "Moonlight Flower"}
}

local YEAR_LIST = {"1 years", "10years", "100years", "1000years", "10000years", "100000years"}
local PILL_LIST = {"Awakening Qi Pill", "Perfect Qi Pill", "Moonlight Qi Pill", "Nine Rotations Pill", "Heavenly Pill", "Demonic Pill", "Dragon Pill", "Divine Ascension Pill", "Endless Flow Pill"}

local currentPillIndex = 1
local currentYearIndex = 1

-- =================================================================
-- 🏹 3. 创建实体视觉检测箭头 (用于画面追踪指引)
-- =================================================================
local ArrowGui = Instance.new("ScreenGui", CoreGui)
ArrowGui.Name = "AlchemyArrowGui"

local VisualArrow = Instance.new("TextLabel", ArrowGui)
VisualArrow.Size = UDim2.new(0, 40, 0, 40)
VisualArrow.BackgroundTransparency = 1
VisualArrow.Text = "⬇️" -- 经典指示箭头
VisualArrow.TextSize = 35
VisualArrow.TextColor3 = Color3.fromRGB(255, 50, 50) -- 显眼红色
VisualArrow.Visible = false
VisualArrow.ZIndex = 999

-- 物理坐标强力点击函数（带视觉追踪效果）
local function trackAndClick(element)
    if element and element.AbsolutePosition and element.AbsoluteSize then
        local targetX = element.AbsolutePosition.X + (element.AbsoluteSize.X / 2)
        local targetY = element.AbsolutePosition.Y + (element.AbsoluteSize.Y / 2)
        
        -- 将可见的物理箭头移动到目标正上方
        VisualArrow.Position = UDim2.new(0, targetX - 20, 0, targetY - 45)
        VisualArrow.Visible = true
        task.wait(0.15) -- 让人眼和系统能反应过来
        
        -- 发射底层鼠标物理敲击
        VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 0)
        return true
    end
    return false
end

