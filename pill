    end
end)

-- =================================================================
-- ⚡ 5. 无限循环逻辑核心：真·实体箭头探测追踪流
-- =================================================================
task.spawn(function()
    while true do
        if _G.AutoCraftActive then
            local success, err = pcall(function()
                local recipe = PILL_RECIPES[_G.SelectedPill]
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                
                if recipe and playerGui then
                    local currentStepSuccess = true
                    
                    -- 【循环选药流程】：依次找到4个匹配文字材料并点USE
                    for i = 1, 4 do
                        if not _G.AutoCraftActive then break end
                        
                        local targetHerb = recipe[i]
                        local targetElement = nil
                        
                        -- 1. 全局深度模糊检测包含【名称】和【年份】的文字资源框
                        for _, v in ipairs(playerGui:GetDescendants()) do
                            if (v:IsA("TextLabel") or v:IsA("TextButton")) and v.Visible then
                                -- 拼接名字和文本，防止游戏把信息藏在不同属性里
                                local matchPool = string.lower(v.Text .. " " .. v.Name .. " " .. (v.Parent and v.Parent.Name or ""))
                                if string.find(matchPool, string.lower(targetHerb)) and string.find(matchPool, string.lower(_G.SelectedYear)) then
                                    -- 确保拿到的是可供点击的框架主体
                                    targetElement = v:IsA("TextButton") and v or v.Parent
                                    break
                                end
                            end
                        end
                        
                        -- 2. 箭头指引第一步：点击资源
                        if targetElement then
                            print("🎯 箭头锁定第 " .. i .. " 个材料: " .. targetHerb)
                            trackAndClick(targetElement)
                            task.wait(0.3) -- 稳定给服务器和UI弹窗渲染时间
                            
                            -- 3. 箭头指引第二步：寻找弹出的 [Use] 或者 [使用] 确认键
                            local useButton = nil
                            for _, v in ipairs(playerGui:GetDescendants()) do
                                if (v:IsA("TextButton") or v:IsA("TextLabel")) and v.Visible then
                                    local txt = string.lower(v.Text)
                                    if txt == "use" or txt == "使用" or txt == "equip" or txt == "放入" then
                                        useButton = v:IsA("TextButton") and v or v.Parent
                                        break
                                    end
                                end
                            end
                            
                            -- 4. 点击 Use 放入栏位
                            if useButton then
                                trackAndClick(useButton)
                                task.wait(0.25)
                            else
                                warn("❌ 找到了材料，但画面上没弹出 Use 选项按钮！")
                                currentStepSuccess = false
                            end
                        else
                            warn("❌ 画面上未找到匹配年份: " .. _G.SelectedYear .. " 的 " .. targetHerb .. "！")
                            currentStepSuccess = false
                            task.wait(0.5) -- 防止找不到材料时死循环过度消耗手机 CPU
                        end
                    end
                    
                    -- 【第四步】：放满正确的材料后，箭头移到 Craft 上一锤定音
                    if currentStepSuccess and _G.AutoCraftActive then
                        local craftButton = nil
                        for _, v in ipairs(playerGui:GetDescendants()) do
                            if (v:IsA("TextButton") or v:IsA("TextLabel")) and v.Visible then
                                local nameTxt = string.lower(v.Text .. " " .. v.Name)
                                if string.find(nameTxt, "craft") or string.find(nameTxt, "合成") or string.find(nameTxt, "refine") then
                                    craftButton = v:IsA("TextButton") and v or v.Parent
                                    break
                                end
                            end
                        end
                        
                        if craftButton then
                            print("🚀 四个材料已放满，箭头锁定合成按钮，开始制作！")
                            trackAndClick(craftButton)
                            task.wait(0.8) -- 等待药丸产出特效，随后进入下一次无限循环
                        end
                    end
                end
            end)
            
            if not success and err then
                print("运行时提示: ", err)
            end
            task.wait(0.1)
        else
            VisualArrow.Visible = false
            task.wait(0.5)
        end
    end
end)

print("[完全体·高亮实体箭头智能炼丹炉] 升级完毕！")
