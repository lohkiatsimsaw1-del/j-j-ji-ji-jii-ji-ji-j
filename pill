    _G.AutoCraftActive = not _G.AutoCraftActive
    if _G.AutoCraftActive then
        CraftBtn.Text = "正在智能炼制中..."
        CraftBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    else
        CraftBtn.Text = "开启智能自动检测"
