-- =================================================================
-- 🧼 1. 清理历史残余 UI
-- =================================================================
for _, oldUI in ipairs(game:GetService("CoreGui"):GetChildren()) do
    if oldUI.Name == "ClickTriggerAssistantUI" then oldUI:Destroy() end
end

-- =================================================================
-- ⚙️ 2. 全局开关状态
-- =================================================================
_G.TriggerAssistantActive = false

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- 精准点击函数
local function autoClickUse(useButton)
    if useButton and useButton.Visible then
        useButton:Activate() -- 触发点击
    end
end

-- =================================================================
-- 📱 3. 创建纯净的 ON / OFF 开关界面
-- =================================================================
local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "ClickTriggerAssistantUI"

local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 130, 0, 45)
ToggleBtn.Position = UDim2.new(0.1, 0, 0.1, 0) -- 放在屏幕左上角
ToggleBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60) -- 默认红色 (OFF)
ToggleBtn.Text = "触发器: OFF"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.TextSize = 16
ToggleBtn.Active = true
ToggleBtn.Draggable = true -- 允许你用手指在屏幕上到处拖动位置
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 8)

-- 开关切换逻辑
ToggleBtn.Activated:Connect(function()
    _G.TriggerAssistantActive = not _G.TriggerAssistantActive
    if _G.TriggerAssistantActive then
        ToggleBtn.Text = "触发器: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- 绿色 (ON)
    else
        ToggleBtn.Text = "触发器: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60) -- 红色 (OFF)
    end
end)

-- =================================================================
-- ⚡ 4. 核心逻辑：你点图片，它秒接 USE
-- =================================================================
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 监听整个 UI 界面的所有点击动作
PlayerGui.DescendantLettersCloned or PlayerGui.DescendantAdded:Connect(function(descendant)
    -- 持续监听新弹出的按钮
end)

-- 每当游戏界面有任何按钮被你按下时触发
local function setupListener()
    for _, button in ipairs(PlayerGui:GetDescendants()) do
        if button:IsA("TextButton") or button:IsA("ImageButton") then
            button.MouseButton1Click:Connect(function()
                -- 只有在开关为 ON 的时候才执行后面的逻辑
                if _G.TriggerAssistantActive then
                    -- 延时万分之一秒，等待游戏的 USE 弹窗现身
                    task.defer(function()
                        -- 在 PlayerGui 里瞬间抓取刚冒出来的 USE / 使用 / Equip 按钮
                        for _, obj in ipairs(PlayerGui:GetDescendants()) do
                            if obj:IsA("TextButton") and obj.Visible then
                                local text = string.lower(obj.Text)
                                if text == "use" or text == "使用" or text == "equip" or text == "放入" then
                                    autoClickUse(obj)
                                    break
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end
end

-- 首次注入时绑定所有按钮，并防止界面刷新后失效
setupListener()
PlayerGui.DescendantAdded:Connect(function(child)
    if child:IsA("TextButton") or child:IsA("ImageButton") then
        child.MouseButton1Click:Connect(function()
            if _G.TriggerAssistantActive then
                task.defer(function()
                    for _, obj in ipairs(PlayerGui:GetDescendants()) do
                        if obj:IsA("TextButton") and obj.Visible then
                            local text = string.lower(obj.Text)
                            if text == "use" or text == "使用" or text == "equip" or text == "放入" then
                                autoClickUse(obj)
                                break
                            end
                        end
                    end
                end)
            end
        end)
    end
end)

print("[触发式助手] 加载成功！手动点图片 -> 自动接USE。")
