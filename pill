local PillBtn = Instance.new("TextButton", MainFrame)
PillBtn.Size = UDim2.new(1, -20, 0, 35)
PillBtn.Position = UDim2.new(0, 10, 0, 40)
PillBtn.BackgroundColor3 = Color3.fromRGB(52, 152, 219)
PillBtn.Text = "目标: " .. _G.SelectedPill
PillBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", PillBtn).CornerRadius = UDim.new(0, 5)

local YearBtn = Instance.new("TextButton", MainFrame)
YearBtn.Size = UDim2.new(1, -20, 0, 35)
YearBtn.Position = UDim2.new(0, 10, 0, 85)
YearBtn.BackgroundColor3 = Color3.fromRGB(155, 89, 182)
YearBtn.Text = "草药年份: " .. _G.SelectedYear
YearBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", YearBtn).CornerRadius = UDim.new(0, 5)

local CraftBtn = Instance.new("TextButton", MainFrame)
CraftBtn.Size = UDim2.new(1, -20, 0, 45)
CraftBtn.Position = UDim2.new(0, 10, 0, 130)
CraftBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
CraftBtn.Text = "自动合成: 已关闭"
CraftBtn.TextColor3 = Color3.new(1,1,1)
CraftBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", CraftBtn).CornerRadius = UDim.new(0, 6)

PillBtn.Activated:Connect(function()
    currentPillIndex = currentPillIndex + 1
    if currentPillIndex > #PILL_LIST then currentPillIndex = 1 end
    _G.SelectedPill = PILL_LIST[currentPillIndex]
    PillBtn.Text = "目标: " .. _G.SelectedPill
end)

YearBtn.Activated:Connect(function()
    currentYearIndex = currentYearIndex + 1
    if currentYearIndex > #YEAR_LIST then currentYearIndex = 1 end
    _G.SelectedYear = YEAR_LIST[currentYearIndex]
    YearBtn.Text = "草药年份: " .. _G.SelectedYear
end)

CraftBtn.Activated:Connect(function()
    _G.AutoCraftActive = not _G.AutoCraftActive
    if _G.AutoCraftActive then
        CraftBtn.Text = "自动合成: 正在检测..."
        CraftBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    else
        CraftBtn.Text = "自动合成: 已关闭"
        CraftBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    end
end)

-- =================================================================
-- 🎯 4. 高精度画面文字自动检测与点击核心
-- =================================================================
-- 模拟点击游戏画面指定 UI 元素的中心点坐标，保证在手机端绝对有效
local function clickElement(element)
    if element and element.AbsolutePosition and element.AbsoluteSize then
        local clickX = element.AbsolutePosition.X + (element.AbsoluteSize.X / 2)
        local clickY = element.AbsolutePosition.Y + (element.AbsoluteSize.Y / 2)
        
        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
        return true
    end
    return false
end

task.spawn(function()
    while true do
        if _G.AutoCraftActive then
            pcall(function()
                local recipe = PILL_RECIPES[_G.SelectedPill]
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                
                if recipe and playerGui then
                    local loopSuccess = true
                    
                    -- 【步骤 1 & 2 & 3】：按配方顺序，依次循环完成 4 次选择
                    for i = 1, 4 do
                        if not _G.AutoCraftActive then break end
                        
                        local targetHerbName = recipe[i]
                        local foundResource = nil
                        
                        -- 全局文字扫描：检测匹配当前[草药名称]与[指定年份]的资源按钮
                        for _, obj in ipairs(playerGui:GetDescendants()) do
                            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Visible then
                                local fullText = string.lower(obj.Text .. " " .. obj.Name)
                                if string.find(fullText, string.lower(targetHerbName)) and string.find(fullText, string.lower(_G.SelectedYear)) then
                                    -- 如果文字在 TextLabel 里，则将其父级（一般是Button）或自身作为点击目标
                                    foundResource = obj:IsA("TextButton") and obj or obj.Parent
                                    break
                                end
                            end
                        end
                        
                        -- 流程核心点：如果检测到相符的文字 Resource
                        if foundResource then
                            -- 1. 点击检测到的相关 Resource
                            clickElement(foundResource)
                            task.wait(0.2) -- 等待游戏弹出 Use / 使用 菜单
                            
                            -- 2. 在画面中扫描新出现的 "Use" / "使用" / "Equip" 确认文字
                            local useButton = nil
                            for _, obj in ipairs(playerGui:GetDescendants()) do
                                if (obj:IsA("TextButton") or obj:IsA("TextLabel")) and obj.Visible then
                                    local t = string.lower(obj.Text)
                                    if t == "use" or t == "使用" or t == "equip" or t == "放入" then
                                        useButton = obj:IsA("TextButton") and obj or obj.Parent
                                        break
                                    end
                                end
                            end
                            
                            -- 点击 use
                            if useButton then
                                clickElement(useButton)
                                task.wait(0.25) -- 等待放入完成，防止动作过快产生物理粘连
                            else
                                loopSuccess = false -- 没点到 use 则判定本轮有瑕疵
                            end
                        else
                            loopSuccess = false -- 画面上没找到对应年份和名称的草药文字
                        end
                    end
                    
                    -- 【步骤 4】：成功完成四个选择，检测并按下 Craft 按钮
                    if loopSuccess then
                        local craftButton = nil
                        for _, obj in ipairs(playerGui:GetDescendants()) do
                            if (obj:IsA("TextButton") or obj:IsA("TextLabel")) and obj.Visible then
                                local t = string.lower(obj.Text .. " " .. obj.Name)
                                if string.find(t, "craft") or string.find(t, "合成") or string.find(t, "refine") then
                                    craftButton = obj:IsA("TextButton") and obj or obj.Parent
                                    break
                                end
                            end
                        end
                        
                        if craftButton then
                            clickElement(craftButton)
                            task.wait(0.6) -- 等待合成药丸特效播放完毕，随后自动【重新进入大循环】
                        end
                    end
                end
            end)
            task.wait(0.1)
        else
            task.wait(0.5)
        end
    end
end)

print("[画面文字检测·智能合成箭流] 加载成功，进入无限自动循环模式！")
