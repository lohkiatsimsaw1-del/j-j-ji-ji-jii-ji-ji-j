-- =================================================================
-- 🔘 4. UI 交互逻辑切换控制
-- =================================================================
PillBtn.Activated:Connect(function()
    currentPillIndex = currentPillIndex + 1
    if currentPillIndex > #PILL_LIST then currentPillIndex = 1 end
    _G.SelectedPill = PILL_LIST[currentPillIndex]
    PillBtn.Text = "目标: " .. _G.SelectedPill
end)

YearBtn.Activated:Connect(function()
    currentYearIndex = currentYearIndex + 1
    if currentYearIndex > #YEAR_LIST then currentYearIndex = 1 end
    _G.SelectedYear = YEAR_LIST[currentYearIndex]
    YearBtn.Text = "草药年份: " .. _G.SelectedYear
end)

CraftBtn.Activated:Connect(function()
    _G.AutoCraftActive = not _G.AutoCraftActive
    if _G.AutoCraftActive then
        CraftBtn.Text = "自动合成: 正在炼制..."
        CraftBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    else
        CraftBtn.Text = "自动合成: 已关闭"
        CraftBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    end
end)

-- =================================================================
-- ⚡ 5. 核心全自动智能配方识别与模拟投放线程
-- =================================================================
task.spawn(function()
    while true do
        if _G.AutoCraftActive then
            pcall(function()
                -- 获取当前选定丹药的四个所需材料名字
                local recipe = PILL_RECIPES[_G.SelectedPill]
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                
                if recipe and playerGui then
                    -- ⚔️ 第一步：寻找并打开游戏内的炼丹/制作面板（游戏内常见命名防呆）
                    local craftFrame = playerGui:FindFirstChild("Craft", true) or playerGui:FindFirstChild("Alchemy", true)
                    
                    -- ⚔️ 第二步：依次投放配方要求的 4 个材料
                    for slotIndex, herbName in ipairs(recipe) do
                        -- 在玩家的背包/材料资源栏内，定位带有指定“年份”和“草药名”的格子
                        -- 格式通常为：10years Ginseng 或 Ginseng (100years)
                        local targetItem = nil
                        for _, item in ipairs(playerGui:GetDescendants()) do
                            if item:IsA("TextButton") or item:IsA("ImageButton") then
                                local text = string.lower(item.Name .. (item:FindFirstChild("Text") and item.Text or ""))
                                if string.find(text, string.lower(herbName)) and string.find(text, string.lower(_G.SelectedYear)) then
                                    targetItem = item
                                    break
                                end
                            end
                        end
                        
                        -- 如果找到了对应的特定年份材料，执行 Equip / 放入操作
                        if targetItem then
                            -- 优先尝试调用点击
                            targetItem:Activate()
                            -- 针对有些非标准按钮，用底层输入系统进行双保险点击
                            VirtualInputManager:SendMouseButtonEvent(targetItem.AbsolutePosition.X + 10, targetItem.AbsolutePosition.Y + 10, 0, true, game, 0)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(targetItem.AbsolutePosition.X + 10, targetItem.AbsolutePosition.Y + 10, 0, false, game, 0)
                            task.wait(0.1) -- 手机端防抽搐温控延迟
                        end
                    end
                    
                    -- ⚔️ 第三步：所有素材填入完毕后，寻找底部的“Craft”或者“合成”按钮并触发
                    local finalCraftButton = nil
                    for _, btn in ipairs(playerGui:GetDescendants()) do
                        if btn:IsA("TextButton") and (string.lower(btn.Text) == "craft" or btn.Text == "合成" or btn.Name == "CraftButton") then
                            finalCraftButton = btn
                            break
                        end
                    end
                    
                    if finalCraftButton then
                        finalCraftButton:Activate()
                    end
                end
            end)
            task.wait(0.5) -- 每半秒完成一轮高品质炼制循环
        else
            task.wait(1)
        end
    end
end)

print("[全自动年份控速炼丹炉] 模块加载就绪，完美支持手机端！")
