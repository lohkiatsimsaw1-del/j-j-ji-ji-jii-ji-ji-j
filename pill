-- =================================================================
-- ⚡ 暴力全局文字穿透搜索
-- =================================================================
task.spawn(function()
    while true do
        if _G.AutoCraftActive then
            -- 这一次我们彻底不用 pcall，如果有报错，让执行器直接把红字吐在你的屏幕上！
            local recipe = PILL_RECIPES[_G.SelectedPill]
            
            -- 【破壁扫描】：不要局限于 PlayerGui，把游戏所有可能放UI的地方全部扫一遍
            local searchPool = {}
            for _, g in ipairs(game:GetService("CoreGui"):GetChildren()) do table.insert(searchPool, g) end
            for _, g in ipairs(LocalPlayer:WaitForChild("PlayerGui"):GetChildren()) do table.insert(searchPool, g) end
            
            print("🔍 [分析] 正在扫描画面中的文字元件，当前目标草药: " .. recipe[1])
            
            local foundHerb = nil
            -- 开始在整个屏幕的UI池子里捞字
            for _, guiElement in ipairs(searchPool) do
                for _, v in ipairs(guiElement:GetDescendants()) do
                    if v:IsA("TextLabel") or v:IsA("TextButton") then
                        if v.Visible and v.Text ~= "" then
                            local txt = string.lower(v.Text)
                            -- 检测有没有包含你想要的草药名字（比如 ginseng）
                            if string.find(txt, string.lower(recipe[1])) then
                                print("🎉 [找到目标文字了！] 文字内容是: " .. v.Text .. " | 所在区域: " .. guiElement.Name)
                                foundHerb = v:IsA("TextButton") and v or v.Parent
                                break
                            end
                        end
                    end
                end
                if foundHerb then break end
            end
            
            if foundHerb then
                -- 找到了就砸箭头并点击
                hardClick(foundHerb)
                task.wait(0.5)
                
                print("🔍 [分析] 正在寻找弹出的 Use 按钮...")
                local foundUse = nil
                for _, guiElement in ipairs(searchPool) do
                    for _, v in ipairs(guiElement:GetDescendants()) do
                        if v:IsA("TextButton") and v.Visible then
                            local t = string.lower(v.Text)
                            if t == "use" or t == "使用" or t == "equip" then
                                foundUse = v
                                break
                            end
                        end
                    end
                end
                
                if foundUse then
                    print("🎉 [找到Use按钮！] 准备点击...")
                    hardClick(foundUse)
                else
                    print("❌ [错误] 找到了草药，但全屏幕扫完都没看到弹出的 'Use' 或 '使用' 按钮。")
                end
            else
                print("❌ [错误] 全屏幕扫描完毕，没有发现任何带有文字 '" .. recipe[1] .. "' 的可见按钮！请确认炼丹/背包界面是否真的打开了。")
            end
            
            task.wait(1.5) -- 拉长排查间隔，方便你看清控制台打印了什么
        else
            task.wait(0.5)
        end
    end
end)
