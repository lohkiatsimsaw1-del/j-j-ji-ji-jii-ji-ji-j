-- =================================================================
-- 🧼 1. 历史 UI 清理，防止多层叠加卡死
-- =================================================================
for _, oldUI in ipairs(game:GetService("CoreGui"):GetChildren()) do
    if oldUI.Name == "AutoAlchemyUI" then oldUI:Destroy() end
end

-- =================================================================
-- ⚙️ 2. 全局炼丹控制参数
-- =================================================================
_G.AutoCraftActive = false
_G.SelectedPill = "Awakening Qi Pill"
_G.SelectedYear = "1 years"  -- 支持 1 years, 10years, 100years 等

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- 精准配方字典（严格对应四个插槽）
local PILL_RECIPES = {
    ["Awakening Qi Pill"]   = {"Ginseng", "Ginseng", "Spirit Grass", "Spirit Grass"},
    ["Perfect Qi Pill"]     = {"Ginseng", "Spirit Grass", "Spirit Grass", "Lotus"},
    ["Moonlight Qi Pill"]   = {"Moonlight Flower", "Moonlight Flower", "Moonlight Flower", "Moonlight Flower"},
    ["Nine Rotations Pill"] = {"Blood Flower", "Blood Flower", "Lotus", "Blood Flower"},
    ["Heavenly Pill"]       = {"Lotus", "Lotus", "Moonlight Flower", "Moonlight Flower"},
    ["Demonic Pill"]        = {"Blood Flower", "Blood Flower", "Blood Flower", "Blood Flower"},
    ["Dragon Pill"]         = {"Ginseng", "Spirit Grass", "Lotus", "Blood Flower"},
    ["Divine Ascension Pill"] = {"Ginseng", "Ginseng", "Moonlight Flower", "Lotus"},
    ["Endless Flow Pill"]   = {"Blood Flower", "Spirit Grass", "Lotus", "Moonlight Flower"}
}

local YEAR_LIST = {"1 years", "10years", "100years", "1000years", "10000years", "100000years"}
local PILL_LIST = {"Awakening Qi Pill", "Perfect Qi Pill", "Moonlight Qi Pill", "Nine Rotations Pill", "Heavenly Pill", "Demonic Pill", "Dragon Pill", "Divine Ascension Pill", "Endless Flow Pill"}

local currentPillIndex = 1
local currentYearIndex = 1

-- =================================================================
-- 📱 3. 手机端 UI 界面（保持原样）
-- =================================================================
local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "AutoAlchemyUI"

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 220, 0, 190)
MainFrame.Position = UDim2.new(0.1, 0, 0.3, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
MainFrame.Active = true
MainFrame.Draggable = true 
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "✥ 智能全自动炼丹炉 (Pill) ✥"
Title.TextColor3 = Color3.fromRGB(240, 240, 240)
Title.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 12

local PillBtn = Instance.new("TextButton", MainFrame)
PillBtn.Size = UDim2.new(1, -20, 0, 35)
PillBtn.Position = UDim2.new(0, 10, 0, 40)
PillBtn.BackgroundColor3 = Color3.fromRGB(52, 152, 219)
PillBtn.Text = "目标: " .. _G.SelectedPill
PillBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", PillBtn).CornerRadius = UDim.new(0, 5)

local YearBtn = Instance.new("TextButton", MainFrame)
YearBtn.Size = UDim2.new(1, -20, 0, 35)
YearBtn.Position = UDim2.new(0, 10, 0, 85)
YearBtn.BackgroundColor3 = Color3.fromRGB(155, 89, 182)
YearBtn.Text = "草药年份: " .. _G.SelectedYear
YearBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", YearBtn).CornerRadius = UDim.new(0, 5)

local CraftBtn = Instance.new("TextButton", MainFrame)
CraftBtn.Size = UDim2.new(1, -20, 0, 45)
CraftBtn.Position = UDim2.new(0, 10, 0, 130)
CraftBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
CraftBtn.Text = "自动合成: 已关闭"
CraftBtn.TextColor3 = Color3.new(1,1,1)
CraftBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", CraftBtn).CornerRadius = UDim.new(0, 6)

PillBtn.Activated:Connect(function()
    currentPillIndex = currentPillIndex + 1
    if currentPillIndex > #PILL_LIST then currentPillIndex = 1 end
    _G.SelectedPill = PILL_LIST[currentPillIndex]
    PillBtn.Text = "目标: " .. _G.SelectedPill
end)

YearBtn.Activated:Connect(function()
    currentYearIndex = currentYearIndex + 1
    if currentYearIndex > #YEAR_LIST then currentYearIndex = 1 end
    _G.SelectedYear = YEAR_LIST[currentYearIndex]
    YearBtn.Text = "草药年份: " .. _G.SelectedYear
end)

CraftBtn.Activated:Connect(function()
    _G.AutoCraftActive = not _G.AutoCraftActive
    if _G.AutoCraftActive then
        CraftBtn.Text = "自动合成: 正在炼制..."
        CraftBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    else
        CraftBtn.Text = "自动合成: 已关闭"
        CraftBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    end
end)

-- =================================================================
-- ⚡ 4. 核心：细节检测与无限循环投放逻辑
-- =================================================================
task.spawn(function()
    while true do
        if _G.AutoCraftActive then
            pcall(function()
                local recipe = PILL_RECIPES[_G.SelectedPill]
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                
                if recipe and playerGui then
                    -- 1. 定位游戏内的炼丹面板
                    local alchemyFrame = playerGui:FindFirstChild("Alchemy", true) or playerGui:FindFirstChild("Craft", true) or playerGui:FindFirstChild("Cauldron", true)
                    
                    if alchemyFrame then
                        -- 寻找界面上的 4 个材料选项栏插槽 (一般以 Slot1, Slot2 或 UIList 形式存在)
                        local slots = {}
                        for _, child in ipairs(alchemyFrame:GetDescendants()) do
                            if child:IsA("TextButton") or child:IsA("ImageButton") then
                                -- 匹配插槽特征（如名字带Slot、或者带有加号、或空的格子）
                                if string.find(string.lower(child.Name), "slot") or child:FindFirstChild("Add") or string.find(string.lower(child.Name), "grid") then
                                    table.insert(slots, child)
                                end
                            end
                        end
                        
                        -- 如果通过名称没排好序，按屏幕物理X坐标从左到右排序，确保对应配方1-4顺序
                        table.sort(slots, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
                        
                        -- 2. 开始精细化按步骤投放（循环 4 个槽位）
                        local loadedCount = 0
                        for i = 1, 4 do
                            local slot = slots[i]
                            local requiredHerb = recipe[i]
                            
                            if slot and requiredHerb then
                                --【步骤1】点击对应的材料槽位以弹出/激活背包选择框
                                slot:Activate()
                                task.wait(0.15) -- 等待背包列表刷新
                                
                                --【步骤2】在弹出的列表/整个Gui中检测对应 [年份] + [草药类型] 的目标材料
                                local targetHerbBtn = nil
                                for _, item in ipairs(playerGui:GetDescendants()) do
                                    if item:IsA("TextButton") or item:IsA("ImageButton") then
                                        local itemText = string.lower(item.Name .. (item:FindFirstChild("Text") and item.Text or ""))
                                        -- 严格校验：必须包含草药名（如 Ginseng）且包含选定年份（如 10years）
                                        if string.find(itemText, string.lower(requiredHerb)) and string.find(itemText, string.lower(_G.SelectedYear)) then
                                            targetHerbBtn = item
                                            break
                                        end
                                    end
                                end
                                
                                --【步骤3】如果检测到了对材料，点击它，并寻找弹出的 "Use" (或 "Equip" / "使用") 按钮
                                if targetHerbBtn then
                                    targetHerbBtn:Activate()
                                    task.wait(0.1)
                                    
                                    -- 寻找 "Use" 确认按钮
                                    local useButton = nil
                                    for _, btn in ipairs(playerGui:GetDescendants()) do
                                        if btn:IsA("TextButton") and btn.Visible then
                                            local btnText = string.lower(btn.Text)
                                            if btnText == "use" or btnText == "equip" or btnText == "使用" or btnText == "放入" then
                                                useButton = btn
                                                break
                                            end
                                        end
                                    end
                                    
                                    -- 点击 Use 放入选项栏
                                    if useButton then
                                        useButton:Activate()
                                        loadedCount = loadedCount + 1
                                        task.wait(0.15) -- 稳健等待，防止放太快发生错位
                                    end
                                end
                            end
                        end
                        
                        --【步骤4】放满四个材料后，触发最后的 Craft 合成动作
                        if loadedCount >= 4 or (not slots[1]) then -- 如果找不到确切插槽，则尝试直接兜底合成
                            local finalCraftButton = nil
                            for _, btn in ipairs(playerGui:GetDescendants()) do
                                if btn:IsA("TextButton") and btn.Visible then
                                    local text = string.lower(btn.Text)
                                    if text == "craft" or text == "合成" or text == "refine" or string.find(string.lower(btn.Name), "craft") then
                                        finalCraftButton = btn
                                        break
                                    end
                                end
                            end
                            
                            if finalCraftButton then
                                finalCraftButton:Activate()
                                task.wait(0.5) -- 等待合成特效和收药，随后进入【无限循环】
                            end
                        end
                        
                    end
                end
            end)
            task.wait(0.2) -- 循环速度调节
        else
            task.wait(0.5)
        end
    end
end)

print("[全自动精细化炼丹炉] 细节检测升级完毕！")
